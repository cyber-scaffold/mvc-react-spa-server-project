import React from "react";
import { createRoot } from "react-dom/client";

//@ts-ignore 这里需要忽略因为这里的绝对路径可能含有后缀名,默认情况下typescript不允许后缀名,所以需要让typescript忽略
import RenderElement from "$$sourceCodeFilePath$$";

type HydrateBootstrapType = {
  rootElement: Element,
  dehydrateData: {
    meta: {
      hostname: string
      platform: string
      version: string
      title: string
      keywords: string
      description: string,
      structured: any
    }
    content: any
  }
};

export default function hydrateBootstrap(params: HydrateBootstrapType) {
  createRoot(params.rootElement).render(<RenderElement {...params.dehydrateData} />);
};